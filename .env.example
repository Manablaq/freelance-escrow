# Optional public build-time override. If omitted, lib/config.ts uses this same
# verified Bradbury deployment. NEXT_PUBLIC_ values are exposed to the browser.
NEXT_PUBLIC_FREELANCE_MARKET_ADDRESS=0x75af88bfA0592CFA63c06f2F68BfD35C13dDd4EF

# Leave empty to use injected browser wallets only. Replace with a real public
# WalletConnect Cloud project ID to enable WalletConnect connectors. This is
# browser-visible configuration, not a private key or wallet secret.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Write-capable Bradbury smoke runner only. Keep disabled until an authorized run.
SMOKE_LIVE_BRADBURY=disabled
SMOKE_BRADBURY_CHAIN_ID=4221
SMOKE_BRADBURY_CONTRACT_ADDRESS=0x066131dffbE72e27AB40446620792d45a9a6054a

# Supported reviewer roles. The runner derives each supplied key's address and
# refuses a mismatch; these addresses are not derived from this file.
SMOKE_BRADBURY_CLIENT_ADDRESS=0x5bB49021001200fE8156a81c7fcF097e535e7181
SMOKE_BRADBURY_FREELANCER_ADDRESS=0x1f87Ae197af539253978d435aD45cCf28Fb95024
SMOKE_BRADBURY_CLIENT_PRIVATE_KEY=0xREPLACE_WITH_AUTHORIZED_CLIENT_PRIVATE_KEY
SMOKE_BRADBURY_FREELANCER_PRIVATE_KEY=0xREPLACE_WITH_AUTHORIZED_FREELANCER_PRIVATE_KEY

# Exact public fixtures used by the current commands.
SMOKE_APPROVAL_DELIVERABLE_URL=https://raw.githubusercontent.com/Manablaq/freelance-escrow/4ffa69be4ed4f5a8122fb57d3d93f29a6056b125/docs/smoke/approval-deliverable.md
SMOKE_REJECTION_DELIVERABLE_URL=https://raw.githubusercontent.com/Manablaq/freelance-escrow/4ffa69be4ed4f5a8122fb57d3d93f29a6056b125/docs/smoke/rejection-deliverable.txt
SMOKE_ESCROW_WEI=1000000000000000000

# Optional only after manual inspection proves the exact prior verification hash
# ended in a terminal failure; never use for pending, accepted, or successful work.
SMOKE_RETRY_VERIFY_FROM_HASH=
